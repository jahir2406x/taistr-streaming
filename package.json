{
  "name": "taistr-streaming",
  "type": "module",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "check:data": "node --experimental-strip-types scripts/check-data.ts",
    "auditar": "node scripts/auditar.mjs",
    "pendientes": "node --experimental-strip-types scripts/pendientes.ts",
    "mensajes": "node --experimental-strip-types scripts/mensajes.ts",
    "precios": "node scripts/precios.mjs",
    "valoraciones:snapshot": "node --experimental-strip-types scripts/valoraciones-snapshot.ts",
    "test": "node --experimental-strip-types --test tests/core.test.ts",
    "build": "node --experimental-strip-types scripts/generar-servicios-json.ts && npm run check:data && astro build && node --experimental-strip-types scripts/postbuild-csp.ts",
    "presupuesto": "node --experimental-strip-types scripts/presupuesto.ts",
    "enlaces": "node --experimental-strip-types scripts/enlaces.ts",
    "seguridad": "node --experimental-strip-types scripts/seguridad.ts",
    "a11y": "node --experimental-strip-types scripts/a11y.ts",
    "verificar": "node --experimental-strip-types scripts/verificar.ts",
    "deploy:cpanel": "node scripts/deploy-cpanel.mjs",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/tailwind": "^5.1.2",
    "astro": "^4.16.18",
    "tailwindcss": "^3.4.17",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3"
  }
}
