Options -Indexes
ServerSignature Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  # /api/consulta -> endpoint PHP
  RewriteRule ^api/consulta/?$ api/consulta.php [L,QSA]
  # Bloquear archivos ocultos y respaldos
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteRule \.(bak|old|orig|tmp|swp|map|sql|log|ini|env|zip)$ - [F,L,NC]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self';"
  Header unset X-Powered-By

  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(css|js|png|svg|ico|webp|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
