{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Iniciar servidor Astro (dev)",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "astro",
        "pattern": {
          "regexp": "^(.*)$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*astro.*",
          "endsPattern": ".*Local.*http://localhost:4321.*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}

