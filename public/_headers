# Cabeceras de seguridad y caché generadas automáticamente tras el build.
# Nota HSTS preload: para solicitar inclusión en hstspreload.org añade "; preload" a Strict-Transport-Security (ver docs/SEGURIDAD.md).
# Justificación style-src 'unsafe-inline': requerido para variables CSS por servicio en atributos style="--acento:..." y transiciones CSSOM.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), hid=(), identity-credentials-get=(), idle-detection=(), local-fonts=(), magnetometer=(), microphone=(), midi=(), otp-credentials=(), payment=(), picture-in-picture=(), publickey-credentials-create=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), storage-access=(), usb=(), web-share=(), xr-spatial-tracking=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-240snoJhqBOni6UzegrCGZxt2/Y3AX+g9udoeLPQG98=' 'sha256-AYgntw18fqvLcUhu93njrVG+IevjpOs00DPyguX9dig=' 'sha256-R+9SQpoODOm05r+b5BW2g8iZZhh7l/QK5efvH1ZP5Hs=' 'sha256-TiCkLVuMhQ4/i+vRFlLwllyY3o9KpcA2mT6gBzfkru0=' 'sha256-bmXKcSofhOXWkQrXojyMKjJsWLU5PYZU1QLXqB36EZA=' 'sha256-jdn+yBgJTD0NBUwn+n/n496fDqB8shZw/NFIYNBDuWI='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests
  Cache-Control: public, max-age=0, must-revalidate

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/og/*
  Cache-Control: public, max-age=31536000, immutable
