# Cabeceras de seguridad y caché equivalentes a _headers (generadas automáticamente tras el build).
# Nota HSTS preload: para solicitar inclusión en hstspreload.org añade "; preload" a Strict-Transport-Security (ver docs/SEGURIDAD.md).
# Justificación style-src 'unsafe-inline': requerido para variables CSS por servicio en atributos style="--acento:..." y transiciones CSSOM.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), hid=(), identity-credentials-get=(), idle-detection=(), local-fonts=(), magnetometer=(), microphone=(), midi=(), otp-credentials=(), payment=(), picture-in-picture=(), publickey-credentials-create=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), storage-access=(), usb=(), web-share=(), xr-spatial-tracking=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-240snoJhqBOni6UzegrCGZxt2/Y3AX+g9udoeLPQG98=' 'sha256-8mcgDin6AwJJDuQY3PVJjLtAb6OMrHg4+g/m1RgnjzY=' 'sha256-R+9SQpoODOm05r+b5BW2g8iZZhh7l/QK5efvH1ZP5Hs=' 'sha256-bmXKcSofhOXWkQrXojyMKjJsWLU5PYZU1QLXqB36EZA=' 'sha256-fMTP/mCBfQQUD+xVO6AGmzxml6oF2iqrxn+vyuBMyCU=' 'sha256-iYCoAwBK3UNAByk6TA4w9nAEDyNMDuMNGkTDDN8SbOc='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"

  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(css|js|png|svg|ico|webp|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

ErrorDocument 404 /404.html
