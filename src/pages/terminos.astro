---
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalDocument from '../components/secciones/LegalDocument.astro';
import { MARCA, AJUSTES, SEO_TEXTOS } from '../editar';
import { parseLegalMarkdown } from '../utils/markdown';
import terminosRaw from '../editar/textos/terminos.md?raw';

const parsed = parseLegalMarkdown(terminosRaw, {
  marca: MARCA.nombre,
  HORARIO_SOPORTE: MARCA.horarioSoporte,
  TIEMPO_RESPUESTA: MARCA.tiempoRespuesta,
  MEDIOS_PAGO: `<span data-geo-payments-summary>${MARCA.mediosPagoResumen.join(', ')}</span>`,
  AVISO_NO_AFILIACION: MARCA.legal.avisoNoAfiliacion,
});
---

<BaseLayout
  title={SEO_TEXTOS.terminos.titulo}
  description={SEO_TEXTOS.terminos.descripcion}
  noindex={!AJUSTES.PAGINAS_CONFIANZA.terminos}
>
  <section class="py-12 sm:py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 space-y-8">
      <div class="space-y-2 border-b border-ground-border pb-6">
        <h1 class="font-display font-bold text-3xl sm:text-4xl text-ink tracking-tight">
          {parsed.frontmatter.titulo}
        </h1>
        <p class="text-sm sm:text-base text-ink-muted leading-relaxed">
          {parsed.frontmatter.subtitulo}
        </p>
        <p class="text-xs text-ink-subtle">
          {parsed.frontmatter.actualizacionLabel} {MARCA.legal.ultimaActualizacionLegal}
        </p>
      </div>

      <LegalDocument sections={parsed.sections} spacingClass="space-y-6" headingClass="text-lg" />
    </div>
  </section>
</BaseLayout>

