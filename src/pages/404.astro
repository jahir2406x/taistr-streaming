---
import BaseLayout from '../layouts/BaseLayout.astro';
import BotonWhatsApp from '../components/ui/BotonWhatsApp.astro';
import { SEO_TEXTOS, TEXTOS_BOTONES } from '../editar';

const t404 = TEXTOS_BOTONES.pagina404;
const acciones = TEXTOS_BOTONES.acciones;
---

<BaseLayout
  title={SEO_TEXTOS.noEncontrado.titulo}
  description={SEO_TEXTOS.noEncontrado.descripcion}
>
  <section class="py-20 sm:py-28">
    <div class="max-w-xl mx-auto px-4 sm:px-6 text-center space-y-6">
      <div class="inline-flex items-center justify-center px-3 py-1 rounded bg-ground-card border border-ground-border text-brand font-display font-bold text-sm">
        {t404.insignia}
      </div>

      <h1 class="font-display font-bold text-3xl sm:text-4xl text-ink">
        {t404.titulo}
      </h1>

      <p class="text-sm sm:text-base text-ink-muted leading-relaxed">
        {t404.descripcion}
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
        <a
          href="/"
          class="inline-flex items-center justify-center bg-brand hover:bg-brand-hover text-ground font-semibold text-sm px-5 py-3 rounded transition-colors"
        >
          {acciones.volverCatalogoInicio}
        </a>

        <BotonWhatsApp
          tipo="consulta_general"
          texto={acciones.escribirPorWhatsapp}
          class="inline-flex items-center justify-center bg-ground-card hover:bg-ground-elevated text-ink font-medium text-sm px-5 py-3 rounded border border-ground-border transition-colors"
        />
      </div>
    </div>
  </section>
</BaseLayout>
