---
import { TEXTOS_BOTONES } from '../../editar';
import type { WhatsAppButtonType } from '../../core';
import BotonWhatsApp from './BotonWhatsApp.astro';

interface Props {
  tipo?: WhatsAppButtonType;
  customMessage?: string;
}

const { tipo = 'boton_flotante', customMessage } = Astro.props;
---

<div class="fixed bottom-[calc(1rem+env(safe-area-inset-bottom,0px))] right-4 z-30 print:hidden">
  <BotonWhatsApp
    tipo={tipo}
    mensajePersonalizado={customMessage}
    ariaLabel="Abrir chat de WhatsApp para consultas"
    class="floating-wa-pulse wa-btn-shine inline-flex items-center gap-2.5 bg-brand-whatsapp hover:bg-brand-whatsappHover text-white font-semibold text-sm px-4 py-3 rounded-full border border-white/15 shadow-lg active:scale-95 transition-transform"
  >
    <svg
      class="w-5 h-5 shrink-0 fill-current"
      viewBox="0 0 24 24"
      aria-hidden="true"
      focusable="false"
    >
      <path
        d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.625.846 5.059 2.284 7.033l-1.492 5.451 5.601-1.469c1.908 1.196 4.168 1.889 6.591 1.889 6.627 0 12-5.373 12-12s-5.373-12-11.984-12.904z"
      ></path>
    </svg>
    <span class="hidden sm:inline">{TEXTOS_BOTONES.acciones.consultasWhatsappFlotante}</span>
    <span class="sm:hidden">{TEXTOS_BOTONES.navegacion.whatsappCorto}</span>
  </BotonWhatsApp>
</div>
