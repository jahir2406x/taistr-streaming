---
import {
  MARCA,
  AJUSTES,
  SERVICIOS,
  PAISES,
  PAGOS,
  TEXTOS_INICIO,
  TEXTOS_BOTONES,
  TEXTOS_POR_PAIS,
} from '../../editar';
import { formatPrice, getPaymentMethodsForCountry, resolverTextoPais } from '../../core';
import BotonWhatsApp from '../ui/BotonWhatsApp.astro';
import ArmadorPedido from './ArmadorPedido.astro';
import FranjaConfianza from '../ui/FranjaConfianza.astro';
import InsigniaServicio from '../servicios/InsigniaServicio.astro';

const services = SERVICIOS;
const defaultPayments = getPaymentMethodsForCountry('PE', PAGOS, PAISES);

const defaultContext = { porPais: TEXTOS_POR_PAIS, paises: PAISES, pagos: PAGOS };
const defaultHeroInsignia = resolverTextoPais('hero_insignia', 'PE', defaultContext);
const defaultHeroTitulo = resolverTextoPais('hero_titulo', 'PE', defaultContext);
const defaultHeroDescripcion = resolverTextoPais('hero_descripcion', 'PE', defaultContext);

const minOverallPrices: Record<string, number> = {};
for (const svc of services) {
  for (const plan of svc.planes) {
    for (const [curr, val] of Object.entries(plan.prices)) {
      if (typeof val === 'number' && (minOverallPrices[curr] === undefined || val < minOverallPrices[curr])) {
        minOverallPrices[curr] = val;
      }
    }
  }
}
const defaultMinOverallFormatted = formatPrice(minOverallPrices.PEN ?? 8, 'PEN', 'es-PE');

const hero = TEXTOS_INICIO.hero;
const acciones = TEXTOS_BOTONES.acciones;
---

<section id="hero-section" class="hero-aurora-section relative border-b border-[var(--border-subtle)] bg-ground py-10 sm:py-14 lg:py-16 overflow-hidden">
  <!-- Fondo tipo aurora con 3 gradientes radiales, parallax suave y capa de ruido CSS -->
  <div class="hero-aurora-bg absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
    <div
      class="hero-glow-blob-1 absolute -top-28 -left-24 w-[26rem] sm:w-[34rem] h-[26rem] sm:h-[34rem] rounded-full opacity-65 blur-xl"
      style="background: radial-gradient(circle, var(--glow-brand) 0%, transparent 68%);"
    ></div>
    <div
      class="hero-glow-blob-2 absolute top-1/4 -right-28 w-[24rem] sm:w-[30rem] h-[24rem] sm:h-[30rem] rounded-full opacity-50 blur-xl"
      style="background: radial-gradient(circle, var(--glow-secondary) 0%, transparent 68%);"
    ></div>
    <div
      class="hero-glow-blob-3 absolute -bottom-24 left-1/3 w-[22rem] sm:w-[28rem] h-[22rem] sm:h-[28rem] rounded-full opacity-40 blur-xl"
      style="background: radial-gradient(circle, var(--glow-brand-subtle) 0%, transparent 70%);"
    ></div>
    <div class="hero-glow-dynamic" aria-hidden="true"></div>
    <div class="hero-grid-pattern absolute inset-0"></div>
    <div class="hero-noise-layer absolute inset-0"></div>
  </div>

  <div class="relative max-w-[var(--container-max)] mx-auto px-[var(--container-px)] space-y-8 lg:space-y-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
      <!-- Columna izquierda (asimétrica más ancha): Propuesta de valor -->
      <div class="lg:col-span-7 min-w-0 space-y-5">
        <div class="flex flex-wrap items-center gap-2 sm:gap-2.5">
          <div class="hero-stagger inline-flex items-center gap-2 max-w-full text-xs sm:text-sm font-medium text-brand bg-[var(--surface-2)] border border-[var(--border-subtle)] px-3.5 py-1.5 rounded-full shadow-sm" style="--i: 0;">
            <span class="w-2 h-2 rounded-full bg-brand shrink-0 animate-pulse" aria-hidden="true"></span>
            <span data-texto-pais="hero_insignia" class="leading-snug">{defaultHeroInsignia}</span>
          </div>

          <div
            id="live-support-badge"
            data-open={MARCA.horarioAtencion.abre}
            data-close={MARCA.horarioAtencion.cierra}
            data-tz={MARCA.horarioAtencion.utcOffset}
            class="hero-stagger inline-flex items-center gap-2 text-xs font-medium text-ink-muted bg-[var(--surface-2)] border border-[var(--border-subtle)] px-3 py-1.5 rounded-full shadow-sm"
            style="--i: 0;"
          >
            <span id="live-support-dot" class="w-2 h-2 rounded-full bg-emerald-400 shrink-0 relative flex items-center justify-center">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            </span>
            <span id="live-support-text" class="text-[11px] sm:text-xs">En línea ahora · Respuesta en 5-15 min</span>
          </div>
        </div>

        <h1 data-texto-pais="hero_titulo" class="font-display font-extrabold text-[length:var(--text-h1)] text-ink tracking-tight leading-[1.08] pb-1">
          {defaultHeroTitulo}
        </h1>

        <p data-texto-pais="hero_descripcion" class="hero-stagger text-base sm:text-lg text-ink-muted max-w-2xl leading-relaxed" style="--i: 1;">
          {defaultHeroDescripcion}
        </p>

        <div class="hero-stagger space-y-2 pt-1" style="--i: 2;">
          <div class="flex flex-wrap items-center gap-3.5">
            <BotonWhatsApp
              tipo="consulta_general"
              class="wa-btn-shine btn-magnetic inline-flex items-center justify-center gap-2.5 bg-brand-whatsapp hover:bg-brand-whatsappHover text-white font-semibold text-base px-6 py-3.5 rounded-[var(--radius-button)] min-h-[44px]"
            >
              <span>{acciones.pedirPorWhatsapp}</span>
            </BotonWhatsApp>

            <a
              href="#catalogo"
              aria-label={`Ver los ${services.length} servicios del catálogo`}
              class="btn-secondary-glass group inline-flex items-center justify-center gap-2 text-ink font-medium text-base px-5 py-3.5 rounded-[var(--radius-button)] min-h-[44px]"
            >
              <span>Ver los {services.length} servicios</span>
              <span class="text-ink-muted group-hover:text-brand group-hover:translate-x-0.5 transition-transform" aria-hidden="true">↓</span>
            </a>
          </div>
          {hero.microTextoCta && (
            <p class="text-xs text-ink-subtle flex items-center gap-1.5 pt-0.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 shrink-0" aria-hidden="true"></span>
              <span>{hero.microTextoCta}</span>
            </p>
          )}
        </div>

        <!-- Línea de apoyo y confianza bajo el CTA principal -->
        <FranjaConfianza variante="hero" />

        <!-- 3 métricas como mini-tarjetas -->
        <dl class="hero-stagger grid grid-cols-3 gap-2.5 sm:gap-3.5 pt-2 max-w-xl" style="--i: 3;">
          <div class="hero-metric-card rounded-xl p-3 sm:p-3.5">
            <dt class="text-[11px] sm:text-xs font-medium text-ink-muted">{hero.metricas.preciosLabel}</dt>
            <dd class="font-display font-bold text-base sm:text-xl text-ink mt-1 min-h-[28px]">
              {
                AJUSTES.SHOW_PRICES ? (
                  <>
                    Desde{' '}
                    <span
                      data-price-map={JSON.stringify(minOverallPrices)}
                      class="geo-price text-brand inline-block min-w-[4.5rem]"
                    >
                      {defaultMinOverallFormatted}
                    </span>
                  </>
                ) : (
                  acciones.consultarPrecio
                )
              }
            </dd>
          </div>
          <div class="hero-metric-card rounded-xl p-3 sm:p-3.5">
            <dt class="text-[11px] sm:text-xs font-medium text-ink-muted">{hero.metricas.garantiaLabel}</dt>
            <dd class="font-display font-bold text-base sm:text-xl text-ink mt-1">{hero.metricas.garantiaValor}</dd>
          </div>
          <div class="hero-metric-card rounded-xl p-3 sm:p-3.5">
            <dt class="text-[11px] sm:text-xs font-medium text-ink-muted">{hero.metricas.activacionLabel}</dt>
            <dd class="font-display font-bold text-base sm:text-xl text-ink mt-1">{hero.metricas.activacionValor}</dd>
          </div>
        </dl>
      </div>

      <!-- Columna derecha: Boleto interactivo / Armador rápido de pedido -->
      <ArmadorPedido />
    </div>

    <!-- Cinta interactiva de plataformas con monogramas 3D -->
    <div class="hero-stagger pt-4 hero-platform-divider" style="--i: 5;">
      <div class="hero-platform-strip flex flex-wrap items-center justify-center gap-2 sm:gap-2.5 py-1">
        {
          services.map((svc) => (
            <a
              href={`/servicios/${svc.slug}`}
              title={`Ver planes de ${svc.nombre}`}
              aria-label={`Ver planes de ${svc.nombre}`}
              style={`--chip-accent: ${svc.color_acento};`}
              class="hero-platform-chip shrink-0 inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-[var(--border-subtle)] text-xs font-medium text-ink-muted hover:text-ink"
            >
              <InsigniaServicio servicio={svc} tamano="sm" esDecorativa={true} />
              <span>{svc.nombre}</span>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>

