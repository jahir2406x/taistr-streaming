---
import { MARCA } from '../../editar';

const redes = (MARCA.redesSociales || {}) as Record<string, string | undefined>;
---

<div data-revelar class="rounded-2xl border border-ground-border bg-gradient-to-r from-ground-elevated/90 via-ground-card to-ground-elevated/90 p-5 sm:p-7 backdrop-blur shadow-sm">
  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
    <div class="space-y-1.5 max-w-xl">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-emerald-950/60 border border-emerald-800/60 text-emerald-300 text-xs font-semibold">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse" aria-hidden="true"></span>
        Canal Oficial de Promociones
      </div>
      <h3 class="font-display text-lg sm:text-xl font-bold text-ink">
        Únete a nuestra comunidad y redes de {MARCA.nombre}
      </h3>
      <p class="text-xs sm:text-sm text-ink-muted leading-relaxed">
        Sigue nuestro canal de WhatsApp para avisos de stock, renovaciones rápidas y ofertas exclusivas de streaming en un solo lugar.
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      {
        redes.canalWhatsapp && (
          <a
            href={redes.canalWhatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="wa-btn-shine btn-press inline-flex items-center gap-2.5 px-4 py-2.5 rounded-xl bg-brand-whatsapp hover:bg-brand-whatsappHover text-white font-semibold text-xs sm:text-sm min-h-[42px]"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.275.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.112.551 4.095 1.517 5.826l-1.611 5.889 6.046-1.585c1.674.914 3.593 1.439 5.632 1.439 6.627 0 12-5.373 12-12 0-6.627-5.373-12-12-12z" />
            </svg>
            <span>Canal de WhatsApp</span>
          </a>
        )
      }

      {
        redes.instagram && (
          <a
            href={redes.instagram}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Instagram de ${MARCA.nombre}`}
            class="btn-secondary-glass inline-flex items-center gap-2 px-3.5 py-2.5 rounded-xl text-ink hover:text-pink-400 font-medium text-xs sm:text-sm min-h-[42px]"
          >
            <svg class="w-4 h-4 text-pink-500 fill-none stroke-current stroke-2" viewBox="0 0 24 24" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
            <span>Instagram</span>
          </a>
        )
      }

      {
        redes.tiktok && (
          <a
            href={redes.tiktok}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`TikTok de ${MARCA.nombre}`}
            class="btn-secondary-glass inline-flex items-center gap-2 px-3.5 py-2.5 rounded-xl text-ink hover:text-cyan-400 font-medium text-xs sm:text-sm min-h-[42px]"
          >
            <svg class="w-4 h-4 text-cyan-400 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.298-.002.595.042.88.13V9.4a6.33 6.33 0 0 0-1-.08A6.34 6.34 0 0 0 3 15.66a6.34 6.34 0 0 0 10.82 4.47 6.28 6.28 0 0 0 1.93-4.52V8.92a8.31 8.31 0 0 0 4.84 1.55v-3.48a4.85 4.85 0 0 1-1-.3z"/>
            </svg>
            <span>TikTok</span>
          </a>
        )
      }
    </div>
  </div>
</div>

