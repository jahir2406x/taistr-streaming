---
import { MARCA, PAISES, TEXTOS_BOTONES } from '../../editar';
import BotonWhatsApp from '../ui/BotonWhatsApp.astro';

const countries = PAISES.filter((c) => c.enabled);
const nav = TEXTOS_BOTONES.navegacion;
---

<header id="site-header" class="sticky top-0 z-40">
  <div id="site-header-inner" class="header-inner max-w-[var(--container-max)] mx-auto px-2.5 sm:px-[var(--container-px)] h-14 sm:h-16 flex items-center justify-between gap-1.5 sm:gap-3">
    <a
      href="/"
      class="inline-flex items-center gap-1.5 sm:gap-2.5 text-ink font-display font-bold text-base sm:text-xl tracking-tight shrink-0 group"
      aria-label={`Ir al inicio de ${MARCA.nombre}`}
    >
      <img
        src="/brand/isotipo.webp"
        alt={`Logo ${MARCA.nombre}`}
        width="34"
        height="34"
        class="w-7 h-7 sm:w-8.5 sm:h-8.5 object-contain group-hover:scale-105 transition-transform shrink-0"
      />
      <span class="tracking-wide">{MARCA.nombre}</span>
    </a>

    <nav id="site-nav" aria-label="Navegación principal" class="hidden md:flex items-center gap-6 text-sm font-medium text-ink-muted relative py-1.5">
      <a href="/#catalogo" data-nav-target="catalogo" class="nav-link hover:text-ink transition-colors">{nav.catalogo}</a>
      <a href="/#como-funciona" data-nav-target="como-funciona" class="nav-link hover:text-ink transition-colors">{nav.comoFunciona}</a>
      <a href="/garantia" data-nav-target="legal" class="nav-link hover:text-ink transition-colors">{nav.garantia}</a>
      <a href="/#preguntas" data-nav-target="preguntas" class="nav-link hover:text-ink transition-colors">{nav.preguntas}</a>
      <span id="nav-indicator" class="nav-sliding-indicator" aria-hidden="true"></span>
    </nav>

    <div class="flex items-center gap-1 sm:gap-2.5 shrink-0">
      <!-- Selector manual de país accesible por teclado -->
      <div class="relative flex items-center min-w-0">
        <label for="country-selector" class="sr-only">Seleccionar país y moneda</label>
        <select
          id="country-selector"
          aria-label="Seleccionar país y moneda"
          class="bg-ground-elevated hover:bg-ground-card text-ink text-[11px] sm:text-xs font-medium px-1.5 sm:px-2.5 py-1 sm:py-1.5 rounded border border-ground-border focus:border-brand transition-colors cursor-pointer max-w-[5.8rem] sm:max-w-none truncate"
        >
          {
            countries.map((c) => (
              <option value={c.code}>
                {c.code === 'default' ? `${c.name} (${c.currency})` : `${c.name} (${c.currency})`}
              </option>
            ))
          }
        </select>
      </div>

      <a
        href="/garantia"
        class="md:hidden inline-flex items-center gap-1 text-[11px] sm:text-xs font-medium text-ink-muted hover:text-ink px-1.5 sm:px-2 py-1 sm:py-1.5 rounded border border-ground-border shrink-0 whitespace-nowrap transition-colors"
      >
        <svg class="w-3 h-3 text-brand shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
        </svg>
        <span>{nav.garantiaCorto}</span>
      </a>

      <BotonWhatsApp
        tipo="consulta_general"
        class="wa-btn-shine inline-flex items-center gap-1 sm:gap-2 bg-brand-whatsapp hover:bg-brand-whatsappHover text-white font-semibold text-[11px] sm:text-sm px-2 sm:px-3.5 py-1 sm:py-2 rounded transition-colors shrink-0 whitespace-nowrap min-h-[36px] sm:min-h-[40px]"
      >
        <span class="w-1.5 h-1.5 sm:w-2 sm:h-2 rounded-full bg-white shrink-0" aria-hidden="true"></span>
        <span class="hidden sm:inline">{nav.atencionWhatsapp}</span>
        <span class="sm:hidden">{nav.whatsappCorto}</span>
      </BotonWhatsApp>

      <!-- Botón accesible de menú móvil -->
      <button
        id="mobile-menu-btn"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
        aria-label="Abrir menú de navegación"
        class="btn-press md:hidden inline-flex items-center justify-center w-8 h-8 rounded text-ink-muted hover:text-ink hover:bg-ground-elevated border border-ground-border shrink-0 cursor-pointer"
      >
        <svg class="w-4 h-4 menu-icon-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg class="w-4 h-4 menu-icon-close hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Desplegable accesible de navegación móvil -->
  <div
    id="mobile-nav-drawer"
    class="hidden md:hidden border-t border-ground-border bg-ground-elevated/95 backdrop-blur-md px-4 py-3 shadow-xl"
  >
    <nav aria-label="Menú móvil" class="flex flex-col gap-1">
      <a href="/#catalogo" data-nav-target="catalogo" class="nav-link-mobile flex items-center justify-between px-3 py-2 rounded-lg text-sm font-medium text-ink-muted hover:text-ink hover:bg-ground-card transition-colors">
        <span>{nav.catalogo}</span>
        <span class="text-xs text-ink-subtle" aria-hidden="true">→</span>
      </a>
      <a href="/#como-funciona" data-nav-target="como-funciona" class="nav-link-mobile flex items-center justify-between px-3 py-2 rounded-lg text-sm font-medium text-ink-muted hover:text-ink hover:bg-ground-card transition-colors">
        <span>{nav.comoFunciona}</span>
        <span class="text-xs text-ink-subtle" aria-hidden="true">→</span>
      </a>
      <a href="/garantia" data-nav-target="legal" class="nav-link-mobile flex items-center justify-between px-3 py-2 rounded-lg text-sm font-medium text-ink-muted hover:text-ink hover:bg-ground-card transition-colors">
        <span>{nav.garantia}</span>
        <span class="text-xs text-ink-subtle" aria-hidden="true">→</span>
      </a>
      <a href="/#preguntas" data-nav-target="preguntas" class="nav-link-mobile flex items-center justify-between px-3 py-2 rounded-lg text-sm font-medium text-ink-muted hover:text-ink hover:bg-ground-card transition-colors">
        <span>{nav.preguntas}</span>
        <span class="text-xs text-ink-subtle" aria-hidden="true">→</span>
      </a>
    </nav>
  </div>
</header>

<script>
  (function () {
    const btn = document.getElementById('mobile-menu-btn');
    const drawer = document.getElementById('mobile-nav-drawer');
    if (!btn || !drawer) return;

    const iconOpen = btn.querySelector('.menu-icon-open');
    const iconClose = btn.querySelector('.menu-icon-close');

    function toggleMenu(open?: boolean) {
      const isCurrentlyOpen = btn.getAttribute('aria-expanded') === 'true';
      const shouldOpen = open !== undefined ? open : !isCurrentlyOpen;

      btn.setAttribute('aria-expanded', shouldOpen ? 'true' : 'false');
      btn.setAttribute('aria-label', shouldOpen ? 'Cerrar menú de navegación' : 'Abrir menú de navegación');

      if (shouldOpen) {
        drawer.classList.remove('hidden');
        if (iconOpen) iconOpen.classList.add('hidden');
        if (iconClose) iconClose.classList.remove('hidden');
      } else {
        drawer.classList.add('hidden');
        if (iconOpen) iconOpen.classList.remove('hidden');
        if (iconClose) iconClose.classList.add('hidden');
      }
    }

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleMenu();
    });

    // Cerrar al pulsar un enlace
    drawer.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        toggleMenu(false);
      });
    });

    // Cerrar con Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        toggleMenu(false);
        btn.focus();
      }
    });

    // Cerrar al hacer clic fuera
    document.addEventListener('click', (e) => {
      if (btn.getAttribute('aria-expanded') === 'true') {
        const target = e.target as Node;
        if (!drawer.contains(target) && !btn.contains(target)) {
          toggleMenu(false);
        }
      }
    });
  })();
</script>
