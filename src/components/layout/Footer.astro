---
import { MARCA, AJUSTES, TEXTOS_PIE, TEXTOS_POR_PAIS, PAISES, PAGOS } from '../../editar';
import { resolverTextoPais } from '../../core';
import BotonWhatsApp from '../ui/BotonWhatsApp.astro';

const currentYear = MARCA.anioActual;
const redes = (MARCA.redesSociales || {}) as Record<string, string | undefined>;
const tieneRedes = Boolean(redes.instagram || redes.tiktok || redes.telegram);

const defaultContext = { porPais: TEXTOS_POR_PAIS, paises: PAISES, pagos: PAGOS };
const defaultAtencionPie = resolverTextoPais('atencion_pie', 'PE', defaultContext);
const defaultPieDescripcion = resolverTextoPais('pie_descripcion', 'PE', defaultContext);
---

<footer class="section-below-fold bg-[var(--surface-2)] border-t border-[var(--border-subtle)] mt-20" data-revelar>
  <div class="max-w-[var(--container-max)] mx-auto px-[var(--container-px)] py-12 sm:py-16">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 pb-10 border-b border-[var(--border-subtle)]">
      <!-- Columna 1: Marca (descripción, horario, correo) -->
      <div class="md:col-span-4 space-y-3.5">
        <div class="flex items-center gap-2.5 font-display font-bold text-xl text-ink">
          <img
            src="/brand/isotipo.webp"
            alt={`Logo ${MARCA.nombre}`}
            width="36"
            height="36"
            class="w-9 h-9 object-contain shrink-0"
          />
          <span class="tracking-wide">{MARCA.nombre}</span>
        </div>
        <p data-texto-pais="pie_descripcion" class="text-sm text-ink-muted max-w-sm leading-relaxed">
          {defaultPieDescripcion}
        </p>
        <p data-texto-pais="atencion_pie" class="text-xs text-ink-muted pt-1">
          {defaultAtencionPie}
        </p>
        {
          MARCA.correoContacto && (
            <p class="text-xs text-ink-muted">
              Correo de contacto:{' '}
              <a
                href={`mailto:${MARCA.correoContacto}`}
                class="text-ink hover:text-brand font-medium transition-colors"
              >
                {MARCA.correoContacto}
              </a>
            </p>
          )
        }
      </div>

      <!-- Columna 2: Enlaces directos y garantía/privacidad -->
      <div class="md:col-span-3 space-y-3">
        <h2 class="text-sm font-semibold text-ink">{TEXTOS_PIE.enlacesTitulo}</h2>
        <ul class="space-y-2 text-sm text-ink-muted">
          {
            TEXTOS_PIE.enlaces.map((item) => (
              <li>
                <a href={item.href} class="hover:text-ink transition-colors">
                  {item.texto}
                </a>
              </li>
            ))
          }
          {
            AJUSTES.PAGINAS_CONFIANZA.quienes_somos && (
              <li>
                <a href={TEXTOS_PIE.enlacesConfianza.quienesSomos.href} class="hover:text-ink transition-colors">
                  {TEXTOS_PIE.enlacesConfianza.quienesSomos.texto}
                </a>
              </li>
            )
          }
          {
            AJUSTES.PAGINAS_CONFIANZA.terminos && (
              <li>
                <a href={TEXTOS_PIE.enlacesConfianza.terminos.href} class="hover:text-ink transition-colors">
                  {TEXTOS_PIE.enlacesConfianza.terminos.texto}
                </a>
              </li>
            )
          }
        </ul>
      </div>

      <!-- Columna 3: Canales oficiales y contacto + Pagos y soporte -->
      <div class="md:col-span-5 space-y-6">
        <!-- Canales oficiales y redes sociales -->
        <div class="space-y-2.5 rounded-xl bg-ground/60 border border-[var(--border-subtle)] p-3.5 sm:p-4">
          <span class="text-xs font-semibold text-ink block">{TEXTOS_PIE.canalesOficiales.titulo}:</span>
          <div class="flex flex-wrap items-center gap-2">
            <BotonWhatsApp
              tipo="consulta_general"
              class="inline-flex items-center gap-1.5 text-xs font-medium text-emerald-300 hover:text-white transition-colors px-2.5 py-1.5 rounded bg-emerald-950/60 border border-emerald-800/60 hover:border-emerald-500"
            >
              <span class="w-2 h-2 rounded-full bg-emerald-400 shrink-0" aria-hidden="true"></span>
              <span>{TEXTOS_PIE.canalesOficiales.whatsappLabel} {MARCA.nombre}</span>
            </BotonWhatsApp>
            {redes.canalWhatsapp && (
              <a
                href={redes.canalWhatsapp}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Canal de WhatsApp de ${MARCA.nombre}`}
                title={`Unirse al canal oficial de WhatsApp de ${MARCA.nombre}`}
                class="inline-flex items-center gap-1.5 text-xs text-ink hover:text-emerald-400 transition-colors px-2.5 py-1.5 rounded bg-brand-whatsapp/20 border border-brand-whatsapp/40 hover:border-brand-whatsapp font-medium"
              >
                <svg class="w-3.5 h-3.5 text-emerald-400 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.275.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.112.551 4.095 1.517 5.826l-1.611 5.889 6.046-1.585c1.674.914 3.593 1.439 5.632 1.439 6.627 0 12-5.373 12-12 0-6.627-5.373-12-12-12z" />
                </svg>
                <span>Canal WhatsApp</span>
              </a>
            )}
            {redes.instagram && (
              <a
                href={redes.instagram}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Instagram de ${MARCA.nombre}`}
                title={`Seguir a ${MARCA.nombre} en Instagram`}
                class="inline-flex items-center gap-1.5 text-xs text-ink-muted hover:text-ink transition-colors px-2.5 py-1.5 rounded bg-ground-card border border-ground-border hover:border-brand/40"
              >
                <svg class="w-3.5 h-3.5 text-pink-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
                </svg>
                <span>Instagram</span>
              </a>
            )}
            {redes.tiktok && (
              <a
                href={redes.tiktok}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`TikTok de ${MARCA.nombre}`}
                title={`Ver videos de ${MARCA.nombre} en TikTok`}
                class="inline-flex items-center gap-1.5 text-xs text-ink-muted hover:text-ink transition-colors px-2.5 py-1.5 rounded bg-ground-card border border-ground-border hover:border-brand/40"
              >
                <svg class="w-3.5 h-3.5 text-cyan-400 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.298-.002.595.042.88.13V9.4a6.33 6.33 0 0 0-1-.08A6.34 6.34 0 0 0 3 15.66a6.34 6.34 0 0 0 10.82 4.47 6.28 6.28 0 0 0 1.93-4.52V8.92a8.31 8.31 0 0 0 4.84 1.55v-3.48a4.85 4.85 0 0 1-1-.3z"/>
                </svg>
                <span>TikTok</span>
              </a>
            )}
            {redes.telegram && (
              <a
                href={redes.telegram}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Canal de Telegram de ${MARCA.nombre}`}
                title={`Unirse al canal de Telegram de ${MARCA.nombre}`}
                class="inline-flex items-center gap-1.5 text-xs text-ink-muted hover:text-ink transition-colors px-2.5 py-1.5 rounded bg-ground-card border border-ground-border hover:border-brand/40"
              >
                <svg class="w-3.5 h-3.5 text-sky-400 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 0 0-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
                </svg>
                <span>Telegram</span>
              </a>
            )}
          </div>
          <p class="text-[11px] text-ink-subtle leading-snug">
            {TEXTOS_PIE.canalesOficiales.avisoSeguridad}
          </p>
        </div>

        <!-- Pagos y botón de soporte -->
        <div class="space-y-2.5">
          <h2 class="text-sm font-semibold text-ink">
            {TEXTOS_PIE.pagosTituloPrefijo}<span data-geo-country-label>{MARCA.paisPorDefecto}</span>{TEXTOS_PIE.pagosTituloSufijo}
          </h2>
          <p class="text-sm text-ink-muted">
            {TEXTOS_PIE.mediosAceptadosLabel} <span data-geo-payments-summary>{MARCA.mediosPagoResumen.join(' · ')}</span>.
          </p>
          <p class="text-xs text-ink-subtle" data-geo-binance-note>
            {TEXTOS_PIE.notaBinance}
          </p>
          <div class="pt-1">
            <BotonWhatsApp
              tipo="consulta_general"
              class="inline-flex items-center gap-2 bg-ground-card hover:bg-ground border border-ground-border text-ink text-sm font-medium px-4 py-2.5 rounded transition-colors"
            >
              <span>{TEXTOS_PIE.botonSoporte}</span>
            </BotonWhatsApp>
          </div>
        </div>
      </div>
    </div>

    <!-- Franja inferior a ancho completo y letra pequeña -->
    <div class="pt-8 space-y-3 text-xs text-ink-muted leading-relaxed">
      <p>{MARCA.legal.avisoNoAfiliacion}</p>
      <p>{MARCA.legal.resumenPrivacidad}</p>
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pt-2 text-ink-subtle">
        <span>© {currentYear} {MARCA.nombre}. {TEXTOS_PIE.derechosReservados}</span>
        <span>
          {TEXTOS_PIE.tarifasActualizadasLabel} <time datetime={AJUSTES.prices_updated_at}>{AJUSTES.prices_updated_at}</time>
        </span>
      </div>
    </div>
  </div>
</footer>
