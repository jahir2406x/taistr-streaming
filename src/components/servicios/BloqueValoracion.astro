---
import { TEXTOS_VALORACIONES, AJUSTES } from '../../editar';

interface Props {
  servicioSlug: string;
  servicioNombre: string;
  acento?: string;
}

const { servicioSlug, servicioNombre, acento = '#3b82f6' } = Astro.props;

const titulo = TEXTOS_VALORACIONES.titulo.replace('{servicio}', servicioNombre);
const subtitulo = TEXTOS_VALORACIONES.subtitulo;
const mostrarDesde = AJUSTES.VALORACIONES.mostrar_desde;
---

<section
  id="opiniones"
  class="widget-valoracion scroll-mt-24 pt-6 border-t border-ground-border"
  data-servicio={servicioSlug}
  data-mostrar-desde={mostrarDesde}
  data-revelar
  style={`--color-acento: ${acento};`}
>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 items-start">
    <!-- Columna Izquierda: Formulario de Calificación y Opinión -->
    <div class="lg:col-span-5 rounded-xl border border-ground-border bg-ground-card/70 p-5 sm:p-6 backdrop-blur space-y-4">
      <!-- Información y resumen -->
      <div class="space-y-2">
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-400 text-xs font-semibold">
          <span>★ Experiencia de clientes</span>
        </div>
        <h3 class="font-display text-lg sm:text-xl font-bold text-ink tracking-tight">
          {titulo}
        </h3>
        <p class="text-xs sm:text-sm text-ink-muted leading-relaxed">
          {subtitulo}
        </p>
        <div class="resumen-valoracion text-sm sm:text-base font-semibold text-amber-400 pt-1" data-val-resumen>
          <span class="primeros-texto text-ink-muted font-normal text-xs sm:text-sm">{TEXTOS_VALORACIONES.primerosEnValorar}</span>
        </div>
      </div>

      <!-- Cuadro de interacción: Estrellas + Nombre + Comentario opcional -->
      <div class="w-full shrink-0" data-val-panel-container>
        <!-- Estado A: Formulario de valoración y opinión -->
        <div
          class="val-box rounded-lg bg-ground-surface/50 p-3.5 sm:p-4 flex flex-col gap-3.5 transition-opacity duration-200"
          data-val-form
        >
          <div class="flex flex-col items-start gap-1.5">
            <span class="text-xs font-medium text-ink-muted" data-val-hint>
              Elige tu calificación:
            </span>
            <div
              role="radiogroup"
              aria-label={`Calificar ${servicioNombre}`}
              class="estrellas-grupo flex items-center gap-1.5 py-1 px-2 rounded-lg bg-ground-elevated/80 border border-ground-border/60"
              data-val-grupo
            >
              {
                [1, 2, 3, 4, 5].map((num) => (
                  <button
                    type="button"
                    role="radio"
                    aria-checked="false"
                    aria-label={TEXTOS_VALORACIONES.ariaLabelEstrella.replace('{n}', String(num))}
                    data-estrella={num}
                    class="estrella-btn group relative p-1 rounded-md text-ink-muted/40 hover:text-amber-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 focus-visible:ring-offset-2 focus-visible:ring-offset-ground-elevated transition-transform active:scale-95 cursor-pointer"
                  >
                    <svg
                      class="estrella-svg w-6 h-6 sm:w-7 sm:h-7 fill-current transition-colors duration-150 pointer-events-none"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                  </button>
                ))
              }
            </div>
          </div>

          <!-- Campos opcionales desplegables: Nombre y Comentario -->
          <div class="val-comentario-campos flex flex-col gap-2.5 pt-1 border-t border-ground-border/60" data-val-campos>
            <div>
              <label class="sr-only" for={`val-nombre-${servicioSlug}`}>Tu nombre o apodo</label>
              <input
                type="text"
                id={`val-nombre-${servicioSlug}`}
                data-val-nombre
                maxlength="40"
                placeholder="Tu nombre o apodo (opcional)"
                class="w-full text-xs sm:text-sm bg-ground-elevated/90 border border-ground-border rounded-lg px-3 py-2 text-ink placeholder:text-ink-muted/50 focus:outline-none focus:border-brand transition-colors"
              />
            </div>
            <div>
              <label class="sr-only" for={`val-comentario-${servicioSlug}`}>Tu comentario o reseña</label>
              <textarea
                id={`val-comentario-${servicioSlug}`}
                data-val-comentario
                rows="2"
                maxlength="280"
                placeholder="¿Qué tal fue la entrega y el servicio? (opcional)"
                class="w-full text-xs sm:text-sm bg-ground-elevated/90 border border-ground-border rounded-lg px-3 py-2 text-ink placeholder:text-ink-muted/50 focus:outline-none focus:border-brand resize-none transition-colors"
              ></textarea>
            </div>
            <!-- Campo honeypot anti-bot invisible para humanos -->
            <input
              type="text"
              name="hp_token"
              data-val-hp
              aria-label="No completar este campo"
              tabindex="-1"
              autocomplete="off"
              class="sr-only"
              aria-hidden="true"
              style="position: absolute; left: -9999px; opacity: 0; pointer-events: none;"
            />
          </div>

          <!-- Botón de entrega y mensajes de estado -->
          <div class="flex flex-col items-stretch gap-1.5 pt-1">
            <button
              type="button"
              class="btn-confirmar-valoracion btn-press inline-flex items-center justify-center font-semibold text-xs sm:text-sm px-4 py-2.5 rounded-lg bg-brand text-ground hover:bg-brand-hover disabled:opacity-40 disabled:cursor-not-allowed shadow-sm cursor-pointer"
              disabled
              data-val-btn-submit
            >
              {TEXTOS_VALORACIONES.botonEnviar}
            </button>
            <span class="feedback-msg text-[11px] text-center font-medium min-h-[1rem] transition-opacity duration-200" data-val-msg></span>
          </div>
        </div>

        <!-- Estado B: Cuadro inactivo para quien ya votó hoy -->
        <div
          class="val-box-locked hidden rounded-lg bg-ground-surface/40 p-4 flex flex-col items-center gap-3 transition-opacity duration-200"
          data-val-locked
        >
          <div class="w-9 h-9 rounded-full bg-emerald-500/15 border border-emerald-500/30 flex items-center justify-center text-emerald-400 shrink-0">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="text-center">
            <div class="flex items-center justify-center gap-2">
              <div class="flex items-center text-amber-400 text-sm tracking-tight" data-val-locked-stars aria-hidden="true">
                ★★★★★
              </div>
              <span class="text-xs font-semibold text-emerald-400">Calificación registrada</span>
            </div>
            <p class="text-xs text-ink-muted mt-1 leading-relaxed">
              {TEXTOS_VALORACIONES.yaValoraste}
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Columna Derecha: Sección de Reseñas y Opiniones Reales de Clientes -->
    <div class="lg:col-span-7 rounded-xl border border-ground-border bg-ground-card/70 p-5 sm:p-6 backdrop-blur space-y-5">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-ground-border">
        <div>
          <h4 class="font-display font-bold text-xl sm:text-2xl text-ink">
            Opiniones reales de {servicioNombre}
          </h4>
          <p class="text-xs sm:text-sm text-ink-muted mt-1">
            Experiencias compartidas por personas que han solicitado su cuenta o perfil en TaiSTR.
          </p>
        </div>

        <!-- Resumen numérico y estrellas grandes -->
        <div class="flex items-center gap-3.5 bg-ground-elevated/60 border border-ground-border/60 rounded-xl px-3.5 py-2 self-start sm:self-auto shrink-0">
          <div class="text-center">
            <span class="font-display font-extrabold text-2xl sm:text-3xl text-amber-400 block leading-tight" data-val-promedio-num>
              5.0
            </span>
            <span class="text-[10px] uppercase tracking-wider text-ink-muted font-medium">Promedio</span>
          </div>
          <div class="space-y-0.5">
            <div class="flex items-center text-amber-400 text-sm tracking-tight" aria-hidden="true">
              ★★★★★
            </div>
            <div class="text-xs text-ink-muted" data-val-total-texto>
              Basado en valoraciones
            </div>
          </div>
        </div>
      </div>

      <!-- Desglose por Estrellas (Barras de distribución) -->
      <div class="grid grid-cols-1 sm:grid-cols-5 gap-2 sm:gap-2.5 py-2 bg-ground-surface/40 rounded-xl p-3 border border-ground-border/40" data-val-desglose-contenedor>
        {
          [5, 4, 3, 2, 1].map((stars) => (
            <div class="flex items-center sm:flex-col sm:items-start gap-2 sm:gap-1 text-xs">
              <span class="text-ink-muted font-medium w-8 sm:w-auto shrink-0">{stars} ★</span>
              <div class="flex-1 sm:w-full h-2 rounded-full bg-ground-elevated overflow-hidden border border-ground-border/30">
                <div
                  class="h-full bg-amber-400 rounded-full"
                  data-val-barra={stars}
                  style="width: 0%;"
                />
              </div>
              <span class="text-[11px] text-ink-muted/80 w-6 sm:w-auto text-right sm:text-left shrink-0" data-val-conteo={stars}>
                0
              </span>
            </div>
          ))
        }
      </div>

      <!-- Lista de Reseñas / Comentarios -->
      <div class="space-y-3 pt-1" data-val-lista-resenas>
        <!-- Estado vacío inicial (se oculta si hay reseñas) -->
        <div
          class="py-8 px-4 text-center border border-dashed border-ground-border/80 rounded-xl bg-ground-surface/20"
          data-val-sin-resenas
        >
          <div class="w-10 h-10 mx-auto rounded-full bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 mb-2">
            ★
          </div>
          <p class="text-sm font-medium text-ink">Aún no hay comentarios detallados para este servicio</p>
          <p class="text-xs text-ink-muted mt-1 max-w-md mx-auto">
            Sé el primero en compartir tu experiencia tras probar tu cuenta. Puedes calificar y dejar tu opinión en el cuadro superior.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    const widgets = document.querySelectorAll('.widget-valoracion');
    if (!widgets.length) return;

    function escaparHtml(str: string): string {
      const p = document.createElement('p');
      p.textContent = str;
      return p.innerHTML;
    }

    function formatearFechaRelativa(timestamp: number): string {
      if (!timestamp) return 'Reciente';
      const ahora = Date.now();
      const diffSeg = Math.floor((ahora - timestamp) / 1000);
      if (diffSeg < 120) return 'Hace un momento';
      const diffMin = Math.floor(diffSeg / 60);
      if (diffMin < 60) return `Hace ${diffMin} min`;
      const diffHoras = Math.floor(diffMin / 60);
      if (diffHoras < 24) return `Hace ${diffHoras} ${diffHoras === 1 ? 'hora' : 'horas'}`;
      const diffDias = Math.floor(diffHoras / 24);
      if (diffDias === 1) return 'Ayer';
      if (diffDias < 30) return `Hace ${diffDias} días`;
      const fecha = new Date(timestamp);
      return fecha.toLocaleDateString('es-PE', { day: 'numeric', month: 'short', year: 'numeric' });
    }

    function crearTarjetaResena(resena: { estrellas: number; nombre: string | null; comentario: string | null; creada: number }): HTMLElement {
      const card = document.createElement('div');
      card.className =
        'resena-card p-4 rounded-xl bg-ground-surface/80 border border-ground-border/70 flex flex-col gap-2.5 transition-colors hover:border-ground-border';

      const nombre = resena.nombre && resena.nombre.trim() ? resena.nombre.trim() : 'Cliente verificado';
      const inicial = nombre.charAt(0).toUpperCase();
      const estrellasStr = '★'.repeat(resena.estrellas) + '☆'.repeat(5 - resena.estrellas);
      const tiempoRelativo = formatearFechaRelativa(resena.creada);

      let comentarioHtml = '';
      if (resena.comentario && resena.comentario.trim()) {
        comentarioHtml = `<p class="text-xs sm:text-sm text-ink-light leading-relaxed pl-1 sm:pl-9">${escaparHtml(resena.comentario)}</p>`;
      }

      card.innerHTML = `
        <div class="flex items-center justify-between gap-3">
          <div class="flex items-center gap-2.5">
            <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-brand/20 border border-brand/30 text-brand font-bold text-xs flex items-center justify-center shrink-0">
              ${escaparHtml(inicial)}
            </div>
            <div>
              <div class="flex items-center gap-2">
                <span class="text-xs sm:text-sm font-semibold text-ink">${escaparHtml(nombre)}</span>
                <span class="inline-flex items-center gap-1 text-[10px] font-medium px-1.5 py-0.5 rounded bg-emerald-950/60 text-emerald-400 border border-emerald-800/40">
                  <span class="w-1 h-1 rounded-full bg-emerald-400" aria-hidden="true"></span>
                  Verificado
                </span>
              </div>
            </div>
          </div>
          <div class="flex flex-col items-end gap-0.5">
            <div class="text-amber-400 text-xs sm:text-sm tracking-tight" aria-label="${resena.estrellas} de 5 estrellas">
              ${estrellasStr}
            </div>
            <span class="text-[10px] sm:text-[11px] text-ink-muted">${escaparHtml(tiempoRelativo)}</span>
          </div>
        </div>
        ${comentarioHtml}
      `;

      return card;
    }

    widgets.forEach((widget) => {
      const svc = widget.getAttribute('data-servicio');
      const min = parseInt(widget.getAttribute('data-mostrar-desde') || '5', 10);
      const grupo = widget.querySelector('[data-val-grupo]');
      const botones = widget.querySelectorAll('.estrella-btn');
      const msgEl = widget.querySelector('[data-val-msg]');
      const hintEl = widget.querySelector('[data-val-hint]');
      const btnSubmit = widget.querySelector('[data-val-btn-submit]');
      const resumenEl = widget.querySelector('[data-val-resumen]');
      const formBox = widget.querySelector('[data-val-form]');
      const lockedBox = widget.querySelector('[data-val-locked]');
      const lockedStars = widget.querySelector('[data-val-locked-stars]');

      const inputNombre = widget.querySelector('[data-val-nombre]') as HTMLInputElement | null;
      const inputComentario = widget.querySelector('[data-val-comentario]') as HTMLTextAreaElement | null;
      const inputHp = widget.querySelector('[data-val-hp]') as HTMLInputElement | null;

      const promedioNumEl = widget.querySelector('[data-val-promedio-num]');
      const totalTextoEl = widget.querySelector('[data-val-total-texto]');
      const listaResenasEl = widget.querySelector('[data-val-lista-resenas]');
      const sinResenasEl = widget.querySelector('[data-val-sin-resenas]');

      if (!svc || !grupo || !btnSubmit) return;

      const storageKey = `val_${svc}_date`;
      const valGuardadoKey = `val_${svc}_score`;
      const hoyUtc = new Date().toISOString().slice(0, 10);
      let yaVotoHoy = false;
      let votoPrevio = 0;
      let estrellaSeleccionada = 0;

      try {
        if (localStorage.getItem(storageKey) === hoyUtc) {
          yaVotoHoy = true;
          votoPrevio = parseInt(localStorage.getItem(valGuardadoKey) || '0', 10);
        }
      } catch (e) {}

      function iluminar(hasta: number) {
        botones.forEach((btn) => {
          const val = parseInt(btn.getAttribute('data-estrella') || '0', 10);
          const icon = (btn.querySelector('.estrella-svg') || btn.querySelector('svg')) as HTMLElement | SVGElement | null;
          if (val <= hasta) {
            btn.classList.add('text-amber-400');
            btn.classList.remove('text-ink-muted/40');
            if (icon) {
              icon.style.color = '#fbbf24';
              icon.style.fill = '#fbbf24';
            }
          } else {
            btn.classList.remove('text-amber-400');
            btn.classList.add('text-ink-muted/40');
            if (icon) {
              icon.style.color = '';
              icon.style.fill = '';
            }
          }
        });
      }

      function activarModoBloqueado(score: number) {
        if (formBox && lockedBox) {
          formBox.classList.add('hidden');
          lockedBox.classList.remove('hidden');
          if (lockedStars) {
            const count = score > 0 ? score : 5;
            lockedStars.textContent = '★'.repeat(count) + '☆'.repeat(5 - count);
          }
        }
      }

      function actualizarDesglose(n: number, distribucion: Record<string, number>) {
        if (!n || n <= 0) return;
        [1, 2, 3, 4, 5].forEach((stars) => {
          const count = distribucion[String(stars)] || 0;
          const pct = Math.round((count / n) * 100);
          const bar = widget.querySelector(`[data-val-barra="${stars}"]`) as HTMLElement | null;
          const countLabel = widget.querySelector(`[data-val-conteo="${stars}"]`);
          if (bar) bar.style.width = `${pct}%`;
          if (countLabel) countLabel.textContent = `${count}`;
        });
      }

      function renderizarResenas(resenas: Array<{ estrellas: number; nombre: string | null; comentario: string | null; creada: number }>) {
        if (!listaResenasEl) return;
        if (!resenas || resenas.length === 0) {
          if (sinResenasEl) sinResenasEl.classList.remove('hidden');
          return;
        }

        if (sinResenasEl) sinResenasEl.classList.add('hidden');

        // Remover tarjetas existentes previas
        const prevCards = listaResenasEl.querySelectorAll('.resena-card');
        prevCards.forEach((c) => c.remove());

        // Insertar tarjetas
        resenas.forEach((r) => {
          const card = crearTarjetaResena(r);
          listaResenasEl.appendChild(card);
        });
      }

      // 1. Cargar datos específicos del servicio (incluyendo desglose y opiniones reales)
      fetch(`/api/valoraciones?servicio=${encodeURIComponent(svc)}`)
        .then((res) => (res.ok ? res.json() : null))
        .then((data) => {
          if (!data || !data.ok) return;
          const { n, promedio, distribucion, resenas } = data;

          if (promedioNumEl && n > 0) {
            promedioNumEl.textContent = promedio.toFixed(1).replace('.', ',');
          }
          if (totalTextoEl) {
            const sufijo = n === 1 ? '1 valoración de cliente' : `${n} valoraciones de clientes`;
            totalTextoEl.textContent = n > 0 ? `Basado en ${sufijo}` : 'Sin valoraciones aún';
          }

          if (resumenEl && n >= min) {
            const promStr = promedio.toFixed(1).replace('.', ',');
            const sufijo = n === 1 ? 'valoración de visitantes' : 'valoraciones de visitantes';
            resumenEl.textContent = `★ ${promStr} · ${n} ${sufijo}`;
          }

          const headerBadge = document.querySelector(`.header-rating-badge[data-header-servicio="${svc}"]`);
          if (headerBadge) {
            const headerText = headerBadge.querySelector('.header-rating-text');
            if (headerText && n > 0) {
              const promStr = promedio.toFixed(1).replace('.', ',');
              headerText.textContent = `${promStr} (${n} ${n === 1 ? 'valoración' : 'valoraciones'}) · Ver opiniones ↓`;
            }
          }

          if (distribucion) {
            actualizarDesglose(n, distribucion);
          }

          if (resenas) {
            renderizarResenas(resenas);
          }
        })
        .catch(() => {});

      if (yaVotoHoy) {
        activarModoBloqueado(votoPrevio);
        return;
      }

      // 2. Manejo de selección de estrellas
      botones.forEach((btn) => {
        const val = parseInt(btn.getAttribute('data-estrella') || '0', 10);

        btn.addEventListener('mouseenter', () => {
          iluminar(val);
        });

        btn.addEventListener('focus', () => {
          iluminar(val);
        });

        btn.addEventListener('click', () => {
          estrellaSeleccionada = val;
          iluminar(val);
          botones.forEach((b) => {
            b.setAttribute('aria-checked', b === btn ? 'true' : 'false');
          });
          btnSubmit.removeAttribute('disabled');
          if (hintEl) {
            hintEl.textContent = `${val} de 5 estrellas seleccionadas:`;
          }
          if (msgEl) {
            msgEl.textContent = '';
          }
        });
      });

      grupo.addEventListener('mouseleave', () => {
        iluminar(estrellaSeleccionada);
      });

      // 3. Envío con confirmación, nombre y comentario opcional
      btnSubmit.addEventListener('click', () => {
        if (estrellaSeleccionada < 1 || estrellaSeleccionada > 5) {
          if (msgEl) {
            msgEl.textContent = 'Selecciona las estrellas primero';
            msgEl.className = 'feedback-msg text-[11px] text-amber-400 font-medium';
          }
          return;
        }

        const nombreVal = inputNombre ? inputNombre.value.trim() : '';
        const comentarioVal = inputComentario ? inputComentario.value.trim() : '';
        const hpVal = inputHp ? inputHp.value.trim() : '';

        btnSubmit.setAttribute('disabled', 'true');
        btnSubmit.textContent = 'Enviando...';

        const payload: Record<string, unknown> = {
          servicio: svc,
          estrellas: estrellaSeleccionada,
        };
        if (nombreVal) payload.nombre = nombreVal;
        if (comentarioVal) payload.comentario = comentarioVal;
        if (hpVal) payload.hp = hpVal;

        fetch('/api/valorar', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(payload),
        })
          .then(async (res) => {
            if (res.status === 409) {
              try {
                localStorage.setItem(storageKey, hoyUtc);
                localStorage.setItem(valGuardadoKey, String(estrellaSeleccionada));
              } catch (e) {}
              activarModoBloqueado(estrellaSeleccionada);
              return;
            }
            if (!res.ok) {
              throw new Error('Error al enviar valoración');
            }
            const json = await res.json();
            try {
              localStorage.setItem(storageKey, hoyUtc);
              localStorage.setItem(valGuardadoKey, String(estrellaSeleccionada));
            } catch (e) {}

            activarModoBloqueado(estrellaSeleccionada);

            // Actualizar interfaz al instante
            if (promedioNumEl && json.promedio) {
              promedioNumEl.textContent = json.promedio.toFixed(1).replace('.', ',');
            }
            if (totalTextoEl && json.n) {
              totalTextoEl.textContent = `Basado en ${json.n} ${json.n === 1 ? 'valoración' : 'valoraciones'}`;
            }

            if (resumenEl && json.n >= min) {
              const promStr = json.promedio.toFixed(1).replace('.', ',');
              const sufijo = json.n === 1 ? 'valoración de visitantes' : 'valoraciones de visitantes';
              resumenEl.textContent = `★ ${promStr} · ${json.n} ${sufijo}`;
            }

            const headerBadge = document.querySelector(`.header-rating-badge[data-header-servicio="${svc}"]`);
            if (headerBadge) {
              const headerText = headerBadge.querySelector('.header-rating-text');
              if (headerText && json.n > 0) {
                const promStr = json.promedio.toFixed(1).replace('.', ',');
                headerText.textContent = `${promStr} (${json.n} ${json.n === 1 ? 'valoración' : 'valoraciones'}) · Ver opiniones ↓`;
              }
            }

            // Si vino la reseña, agregarla arriba de la lista inmediatamente
            if (json.resena && listaResenasEl) {
              if (sinResenasEl) sinResenasEl.classList.add('hidden');
              const nuevaCard = crearTarjetaResena(json.resena);
              listaResenasEl.insertBefore(nuevaCard, listaResenasEl.firstChild);
            }
          })
          .catch(() => {
            btnSubmit.removeAttribute('disabled');
            btnSubmit.textContent = 'Enviar valoración';
            if (msgEl) {
              msgEl.textContent = 'No se pudo registrar. Inténtalo más tarde.';
              msgEl.className = 'feedback-msg text-[11px] text-rose-400 font-medium';
            }
          });
      });

      // Teclado accesible
      grupo.addEventListener('keydown', (e) => {
        const ev = e as KeyboardEvent;
        if (ev.key !== 'ArrowRight' && ev.key !== 'ArrowLeft') return;
        const current = document.activeElement;
        const idx = Array.from(botones).indexOf(current as Element);
        if (idx === -1) return;
        ev.preventDefault();
        const nextIdx = ev.key === 'ArrowRight' ? Math.min(botones.length - 1, idx + 1) : Math.max(0, idx - 1);
        (botones[nextIdx] as HTMLElement).focus();
      });
    });
  })();
</script>